# ─────────────────────────────────────────────────────────────
#  branditbro — environment variables
#  Copy this file to `.env.local` and fill in the values you need.
#  Everything works WITHOUT these set (the site runs, enquiries log
#  + the WhatsApp fallback still fire). Set each group when you want
#  that capability switched on.
# ─────────────────────────────────────────────────────────────

# ── Email (Launchwing Emailer) ───────────────────────────────
# All site email goes through Launchwing (sender: @branditbro.com, verified).
#  • Enquiry auto-reply + team alert: sent by the Launchwing "Contact" form
#    itself (Forms → Contact → Emails). No code/keys needed.
#  • Careers receipt + team alert, and the enquiry fallback alert: sent from
#    the server via the Emailer API — needs this SECRET key (server-only!).
#    Create it in Launchwing → API keys → Create secret key → "Emailer only".
LAUNCHWING_SECRET_KEY=
# Optional template overrides (defaults are baked into src/lib/launchwing.ts)
# LAUNCHWING_TPL_APPLICATION_RECEIVED=
# LAUNCHWING_TPL_TEAM_ALERT=

# ── Lead storage + admin dashboard ───────────────────────────
# A Postgres connection string. Works with AWS RDS, Neon, Supabase or a
# local Postgres. When set, every enquiry is saved and appears at /admin.
# When unset, the site still runs and email/WhatsApp still deliver leads.
#   e.g. postgres://user:pass@host:5432/branditbro
DATABASE_URL=

# Set to "disable" ONLY for a local Postgres without TLS. Managed
# databases (RDS/Neon/Supabase) need TLS, so leave this blank for them.
DATABASE_SSL=

# ── Admin login (the /admin dashboard) ───────────────────────
# The single owner password used to sign in at /admin/login.
# Until this is set, the admin login returns "not configured".
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Set any long random
# string (e.g. `openssl rand -hex 32`). Falls back to ADMIN_PASSWORD
# if left blank — fine to start, but set a dedicated secret in production.
ADMIN_SESSION_SECRET=

# ── AI pricing interview for the /pricing builder (optional) ─────────
# When set, a CUSTOM industry (e.g. "Gaming") triggers an adaptive, AI-
# generated Q&A that scopes and prices the project one question at a time,
# using Gemini. Known industries use the fast built-in flow (no AI). Every
# generated question is cached in Postgres by its path, so repeat journeys
# cost nothing. Get a free key at aistudio.google.com. With no key, a compact
# built-in fallback script keeps the flow working.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=

# ── Launchwing Copilot form (lead mirroring, optional) ───────
# When both are set, every enquiry is also submitted to this Launchwing form
# (fields: what_do_you_need, name, whatsapp_number, email). Best-effort —
# a Launchwing failure never blocks the enquiry.
LAUNCHWING_FORM_ID=
LAUNCHWING_KEY=
